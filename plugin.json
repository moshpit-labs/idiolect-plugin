{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "idiolect",
  "version": "0.4.0",
  "description": "Write and revise emails, messages, posts, and docs in your voice with your portable Writing Profile.",
  "author": {
    "name": "Idiolect AI",
    "url": "https://idiolect.app"
  },
  "homepage": "https://idiolect.app",
  "repository": "https://github.com/Moshpit-Labs/idiolect-plugin",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Idiolect AI",
        "shortDescription": "Write in your voice",
        "longDescription": "Write and revise emails, messages, posts, and docs in your voice with your portable Writing Profile.",
        "developerName": "Idiolect AI",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://idiolect.app",
        "privacyPolicyURL": "https://idiolect.app/privacy",
        "termsOfServiceURL": "https://idiolect.app/terms",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png",
        "defaultPrompt": [
          "Write a reply in my voice.",
          "Rewrite this in my voice."
        ],
        "supportURL": "https://idiolect.app/support"
      }
    }
  },
  "keywords": [
    "writing",
    "personalization",
    "writing-profile",
    "productivity"
  ]
}
